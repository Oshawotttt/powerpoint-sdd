@echo off
rem Combine a deck's spec into one file: <spec folder>\FULL.md.
rem Usage: combine.bat [spec folder]   (default: current directory)
rem Writes ARCHITECTURE.md, then every [0-9][0-9]-*.md section file in file-name order.
rem %DIR% and %OUT% appear only inside quotes or as delayed !DIR! / !OUT!, so
rem folder names with spaces, ( ) or & are not parsed by cmd.
setlocal DisableDelayedExpansion

set "DIR=%~1"
if "%DIR%"=="" set "DIR=."
set "OUT=%DIR%\FULL.md"
rem Full path, so it works even when System32 is missing from PATH (e.g. under Git Bash).
set "FINDSTR=%SystemRoot%\System32\findstr.exe"

if not exist "%DIR%\ARCHITECTURE.md" goto missing

> "%OUT%" (
    echo ^<!-- Generated by /ppt-combine. Do not edit: edit ARCHITECTURE.md and the section files. --^>
    echo(
    type "%DIR%\ARCHITECTURE.md"
    for /f "delims=" %%f in ('dir /b /a-d /on "%DIR%\??-*.md" 2^>nul ^| "%FINDSTR%" /r "^[0-9][0-9]-.*\.md$"') do (
        echo(
        echo ---
        echo(
        type "%DIR%\%%f"
    )
)
if errorlevel 1 exit /b 1

setlocal EnableDelayedExpansion
echo(!OUT!
exit /b 0

:missing
setlocal EnableDelayedExpansion
>&2 echo(ARCHITECTURE.md not found in !DIR!
exit /b 1
